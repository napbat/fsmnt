/target

# Filesystem test fixtures are generated by each crate's
# testdata/gen-fixtures.sh (or create-testfs*.sh), not committed.
**/testdata/*.img
**/testdata/testfs*

# Local libFuzzer state.
crates/fsmnt-fuzz/artifacts/
crates/fsmnt-fuzz/corpus/

# Canonical upstream fixtures required by integration tests.
!crates/formats/fs-exfat/testdata/testfs1
!crates/formats/fs-ext/testdata/ext4-fscrypt.img
